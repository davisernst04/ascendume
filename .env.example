# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---------------------------------------------------------------

# Neon → your project → Connect → copy the connection string.
# For local testing, use a separate Neon branch (Branches → Create branch).
DATABASE_URL=

# Any random 32+ byte string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# The URL you open in the browser. Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# platform.openai.com → API keys. Needs billing credit. Used by review, rewrites, PDF import.
OPENAI_API_KEY=

# --- Optional ---------------------------------------------------------------

# Vercel → Storage → Blob (private store). Without it, uploads still work but the original PDF isn't kept.
BLOB_READ_WRITE_TOKEN=

# OAuth: each provider's button appears only when both values are set.
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/<github|google|microsoft>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
